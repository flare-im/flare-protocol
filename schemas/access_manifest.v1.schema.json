{
  "$defs": {
    "AccessPoint": {
      "properties": {
        "host": {
          "description": "公网可签发证书的域名；禁止裸 IP。",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ipHints": {
          "default": [],
          "description": "仅原生端使用：DNS 失败或可疑时直连，SNI 与证书校验仍按 `host`。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "priority": {
          "default": 0,
          "description": "0 最高；每级在打分里加 50ms。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "services": {
          "$ref": "#/$defs/Services"
        },
        "spkiPins": {
          "default": [],
          "description": "可选的 SPKI SHA-256 钉扎（base64）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ApStatus"
        },
        "tags": {
          "default": [],
          "description": "网络适配标签，例如 `isp:ct`、`net:ipv6`、`udp:ok`。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "weight": {
          "default": 100,
          "description": "同档内加权随机的权重，0–1000。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "host",
        "status",
        "services"
      ],
      "type": "object"
    },
    "ApStatus": {
      "description": "接入点状态。未知值按「不可用」处理：新版控制面可以加状态，旧客户端不会误把它当成 active。",
      "oneOf": [
        {
          "const": "active",
          "description": "正常接新连接。",
          "type": "string"
        },
        {
          "const": "draining",
          "description": "不接新连接，已有连接按排空窗口迁走。",
          "type": "string"
        },
        {
          "const": "disabled",
          "description": "从候选中移除。",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "本版本不认识的状态。",
          "type": "string"
        }
      ]
    },
    "BootstrapSection": {
      "properties": {
        "refreshIntervalSec": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BootstrapSource"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "BootstrapSource": {
      "description": "引导源。`kind` 用字符串而不是封闭枚举：新版控制面可以加源类型，旧客户端忽略即可。",
      "properties": {
        "ipHints": {
          "description": "仅 `https` 镜像、仅原生端使用：规则同接入点的 `ipHints`，SNI 与证书校验仍按 URL 的主机名。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "`https` | `wellKnown` | `dohTxt`。",
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Cell": {
      "properties": {
        "accessPoints": {
          "items": {
            "$ref": "#/$defs/AccessPoint"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "accessPoints"
      ],
      "type": "object"
    },
    "PathService": {
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "Placement": {
      "properties": {
        "allowedRegions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "homeCell": {
          "description": "应用归属 Cell：客户端只在该 Cell 的接入点之间切换。",
          "type": "string"
        }
      },
      "required": [
        "homeCell"
      ],
      "type": "object"
    },
    "PortService": {
      "properties": {
        "port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "port"
      ],
      "type": "object"
    },
    "Region": {
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        },
        "displayName": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "语言标签 → 显示名。",
          "type": "object"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "cells"
      ],
      "type": "object"
    },
    "ReleaseSection": {
      "properties": {
        "channels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Services": {
      "properties": {
        "coreApi": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathService"
            },
            {
              "type": "null"
            }
          ]
        },
        "imQuic": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortService"
            },
            {
              "type": "null"
            }
          ]
        },
        "imWs": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathService"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathService"
            },
            {
              "type": "null"
            }
          ]
        },
        "ping": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathService"
            },
            {
              "type": "null"
            }
          ]
        },
        "socialApi": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathService"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://flare.im/schemas/access_manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "appId": {
      "type": "string"
    },
    "bootstrap": {
      "$ref": "#/$defs/BootstrapSection",
      "default": {
        "sources": []
      }
    },
    "bootstrapId": {
      "description": "每个应用随机生成的引导 ID，与 `appId` 解耦（镜像路径用它，避免枚举租户）。",
      "type": "string"
    },
    "clientPolicy": {
      "description": "原样保留：解析时逐字段宽松读取并夹紧到硬上下限，见 [`ClientPolicy::resolve`]。"
    },
    "expiresAt": {
      "description": "RFC 3339；过期后仍可用于连接，但标记 stale 并提高刷新频率。",
      "format": "date-time",
      "type": "string"
    },
    "issuedAt": {
      "description": "RFC 3339。",
      "format": "date-time",
      "type": "string"
    },
    "placement": {
      "$ref": "#/$defs/Placement"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/Region"
      },
      "type": "array"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "flare.access.v1",
      "description": "固定为 `flare.access.v1`。",
      "type": "string"
    },
    "serial": {
      "description": "同一 `bootstrapId` 单调递增。",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "bootstrapId",
    "appId",
    "serial",
    "issuedAt",
    "expiresAt",
    "regions",
    "placement"
  ],
  "title": "Flare access manifest v1",
  "type": "object"
}
